# Dependencies and build artifacts
node_modules/
npm-debug.log*

# The artifacts/ directory is included in the build context so Dockerfiles can
# COPY servoy_linux.*.tar.gz from it.  In CI the tarball is downloaded into
# artifacts/ before the build; locally developers place it there manually.
# See ci/README.md for setup instructions.

# Git internals — not needed inside the image
.git/
.gitignore

# IDE / OS files
.DS_Store
Thumbs.db
*.swp
*.swo

# Session / plan artifacts
.copilot/
